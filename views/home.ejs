<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('components/head') %>
  <title>Home</title>
</head>

<body>
  <%- include('components/header') %>
  <main>
    <h3>Welcome to the Waraton Post</h3>
    <p>Here you can create, edit, and delete posts. These functionalities are simple to use and require little to no fore-knowledge requirement.</p>
    <p>Are you familiar with Markdown? Make your posts elegant by including markdown in to your posts.</p>
    <p>weSING you Happy Posting!!</p>
    <h4>Create an account</h4>
    <p>Create your account in a few simple steps to get started</p>
    <form action="/register" method="POST">

      <% errors.forEach(err=>{%>
        <p class="notice">
          <%= err %>
        </p>
        <% }) %>

          <fieldset>
            <legend>Create an account</legend>
            <label for="username">Username</label>
            <input autocomplete="off" type="text" name="username" id="username">

            <label for="password">password</label>
            <input type="password" name="password" id="password" autocomplete="off"><br>
            <button>Sign Up</button>
            <p>Already having an account? Simply <a href="/login">Log In to your account</a></p>
          </fieldset>
    </form>

    <blockquote>The heart of the wise makes his speech judicious and adds persuasiveness to his lips. - Proverbs 16:23</blockquote>
  </main>
  <%- include('components/footer') %>
</body>

</html>
<!-- just before login functionality: 17 min -->