<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('components/head') %>
  <title>Home</title>
</head>

<body>
  <%- include('components/header') %>
  <main>
    <h3>WElcome to the Homepage</h3>
    <p>Create your account in a few simple steps</p>
    <form action="/register" method="POST">

      <% errors.forEach(err=>{%>
        <p class="notice">
          <%= err %>
        </p>
        <% }) %>

          <fieldset>
            <legend>Create an account</legend>
            <label for="username">Username</label>
            <input type="text" name="username" id="username">

            <label for="password">password</label>
            <input type="password" name="password" id="password" autocomplete="off"><br>
            <button>Sign Up</button>
          </fieldset>
    </form>

    <blockquote>The heart of the wise makes his speech judicious and adds persuasiveness to his lips. - Proverbs 16:23</blockquote>
  </main>
  <%- include('components/footer') %>
</body>

</html>
<!-- just before login functionality: 17 min -->