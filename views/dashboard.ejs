<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('components/head') %>
  <title>Dash_____Board</title>
</head>

<body>
  <%- include('components/header') %>
  <main>
    <hgroup>
      <h3>Hello <%= user.name %>, welcome to your Dash_____Board!!</h3>
      <% if (posts.length) { %>
       <p>Here are your posts</p>
      <% } else { %>
       <p>You do not have any posts. You can <a href="/create-post">create a new one here</a></p>
       <% } %>
    </hgroup>

    <ul>
      <% posts.forEach(element => {%>
        <li>
          <a href="/post/<%= element.id %>"><%= element.title %></a> on <%= element.createDate %>
        </li>
      <% }); %>
    </ul>
    
    <h3>Color Converter</h3>
    <form action="/convert" method="post">
      <fieldset>
        <legend>Convert Color from A to B</legend>
        
        <div>
          <label for="color">Color:</label>
          <input type="color" name="color" id="color">
          <button>Convert Color</button>
        </div>
      </fieldset>
    </form>

    <blockquote>I love the Lord, for he heard my voice; he heard my cry for mercy. Because he turned his ear to me, I will call on him as long as I live. - Psalm 116:1-2</blockquote>
  </main>
  <%- include('components/footer') %>
</body>

</html>
