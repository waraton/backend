<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('components/head') %>
  <title>Create Post</title>
</head>

<body>
  <%- include('components/header') %>
  <main>
    <h3>Create a post</h3>
    <p>Create your posts in a few simple steps</p>
    <form action="/create-post" method="POST">

      <% errors.forEach(err=>{%>
        <p class="notice">
          <%= err %>
        </p>
      <% }) %>

      <fieldset>
            <legend>Create a new post</legend>
            <label for="title">Title</label>
            <input autocapitalize="words" type="text" autocomplete="off" autofocus name="title" id="title">

            <label for="body">Content</label>
            <textarea autocomplete="off" autocapitalize="sentences" name="body" id="body"></textarea><br>
            <button>Create new Post</button>
      </fieldset>
    </form>

    <blockquote>“I am the Alpha and the Omega,” says the Lord God, “who is, and who was, and who is to come, the Almighty.” - Revelation 1:8</blockquote>
  </main>
  <%- include('components/footer') %>
</body>

</html>
<!-- just before login functionality: 17 min -->